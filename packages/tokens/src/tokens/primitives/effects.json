{
  "shadow": {
    "$type": "shadow",
    "soft-sm": {
      "$value": [
        { "color": "#0b0d1214", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#0b0d120f", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "-1px" }
      ]
    },
    "soft-lg": {
      "$value": [
        { "color": "#0b0d122e", "offsetX": "0px", "offsetY": "16px", "blur": "40px", "spread": "-12px" },
        { "color": "#0b0d1214", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "-4px" }
      ]
    },
    "soft-sm-dark": {
      "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }]
    },
    "soft-lg-dark": {
      "$value": [{ "color": "#00000099", "offsetX": "0px", "offsetY": "20px", "blur": "48px", "spread": "-12px" }]
    },
    "hard-sm": {
      "$description": "The sign-painter shadow: a solid ink offset, no blur.",
      "$value": [{ "color": "{color.kajal.950}", "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px" }]
    },
    "hard-lg": {
      "$value": [{ "color": "{color.kajal.950}", "offsetX": "6px", "offsetY": "6px", "blur": "0px", "spread": "0px" }]
    },
    "hard-sm-dark": {
      "$value": [{ "color": "#000000", "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px" }]
    },
    "hard-lg-dark": {
      "$value": [{ "color": "#000000", "offsetX": "6px", "offsetY": "6px", "blur": "0px", "spread": "0px" }]
    }
  },
  "duration": {
    "$type": "duration",
    "$description": "UI motion stays under 500ms. Most interactions use fast or base.",
    "fast": { "$value": { "value": 120, "unit": "ms" } },
    "base": { "$value": { "value": 200, "unit": "ms" } },
    "slow": { "$value": { "value": 320, "unit": "ms" } },
    "slower": { "$value": { "value": 480, "unit": "ms" } }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1], "$description": "Moving between two on-screen states." },
    "enter": { "$value": [0.16, 1, 0.3, 1], "$description": "Things arriving: fast start, soft landing." },
    "exit": { "$value": [0.4, 0, 1, 1], "$description": "Things leaving: gentle start, quick finish." },
    "sheet": { "$value": [0.32, 0.72, 0, 1], "$description": "Bottom sheets and drawers — the iOS sheet curve." }
  },
  "z": {
    "$type": "number",
    "base": { "$value": 0 },
    "raised": { "$value": 10 },
    "dropdown": { "$value": 1000 },
    "sticky": { "$value": 1100 },
    "overlay": { "$value": 1300 },
    "modal": { "$value": 1400 },
    "toast": { "$value": 1500 },
    "tooltip": { "$value": 1600 }
  }
}
