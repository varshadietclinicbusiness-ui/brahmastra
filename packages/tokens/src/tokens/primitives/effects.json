{
  "duration": {
    "$type": "duration",
    "$description": "UI motion stays under 500ms. Most interactions use fast or base.",
    "instant": {
      "$value": {
        "value": 80,
        "unit": "ms"
      },
      "$description": "Colour and opacity changes on press and hover."
    },
    "fast": {
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "base": {
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "slow": {
      "$value": {
        "value": 320,
        "unit": "ms"
      }
    },
    "slower": {
      "$value": {
        "value": 480,
        "unit": "ms"
      }
    }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": {
      "$value": [
        0.2,
        0,
        0,
        1
      ],
      "$description": "Moving between two on-screen states."
    },
    "enter": {
      "$value": [
        0.16,
        1,
        0.3,
        1
      ],
      "$description": "Things arriving: fast start, soft landing."
    },
    "exit": {
      "$value": [
        0.4,
        0,
        1,
        1
      ],
      "$description": "Things leaving: gentle start, quick finish."
    },
    "sheet": {
      "$value": [
        0.32,
        0.72,
        0,
        1
      ],
      "$description": "Bottom sheets and drawers — the iOS sheet curve."
    },
    "overshoot": {
      "$value": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "$description": "A small, happy overshoot for confirmations: like, add to cart, success ticks. Never for layout."
    },
    "linear": {
      "$value": [
        0,
        0,
        1,
        1
      ],
      "$description": "Only for things that spin or loop, like spinners and progress shimmer."
    }
  },
  "z": {
    "$type": "number",
    "base": {
      "$value": 0
    },
    "raised": {
      "$value": 10
    },
    "dropdown": {
      "$value": 1000
    },
    "sticky": {
      "$value": 1100
    },
    "overlay": {
      "$value": 1300
    },
    "modal": {
      "$value": 1400
    },
    "toast": {
      "$value": 1500
    },
    "tooltip": {
      "$value": 1600
    }
  },
  "blur": {
    "$type": "dimension",
    "$description": "Background blur for glass surfaces (sticky bars over content, chips on photos).",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
