{
  "name": "@brahmastra/ui",
  "version": "0.0.0",
  "description": "Brahmāstra's styled layer: the headless components plus one CSS file built from the tokens.",
  "author": "Mayur Choudhary (https://mayurchoudhary.in)",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["*.css"],
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./brahmastra.css": "./dist/brahmastra.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@brahmastra/headless": "workspace:*",
    "@brahmastra/tokens": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
